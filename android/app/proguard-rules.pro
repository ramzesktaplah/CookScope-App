# CookScope ProGuard / R8 keep rules
#
# Only protect reflective surfaces that R8 cannot see through static
# analysis. Third-party SDKs (Ktor, Supabase, RevenueCat, Coil, Koin,
# CameraX, AdMob, Play Integrity) ship their own consumer ProGuard rules
# which R8 applies automatically — we do NOT blanket-keep their packages
# here, as that prevents R8 from shrinking unused code and causes OOM.

# ---------------------------------------------------------------------------
# Keep attributes for debuggable stack traces with the mapping file
# ---------------------------------------------------------------------------
-keepattributes SourceFile, LineNumberTable, *Annotation*, Signature, InnerClasses, EnclosingMethod, Exceptions, Deprecated

# Rename source file name in stack traces for obfuscation
-renamesourcefileattribute SourceFile

# Disable optimization pass (bytecode optimization is memory-intensive
# and not needed for obfuscation). Shripping IS enabled so R8 can
# eliminate dead code before obfuscation — this reduces peak memory
# by shrinking the class graph that the obfuscation phase must process.
# Obfuscation (class/method name renaming) still runs, which is the
# core M7 security goal: hiding internal class and method names.
-dontoptimize

# ---------------------------------------------------------------------------
# kotlinx.serialization
# https://github.com/Kotlin/kotlinx.serialization/blob/master/kotlinx-serialization/README.md
# ---------------------------------------------------------------------------
-keepattributes RuntimeVisibleAnnotations, AnnotationDefault

# Keep @Serializable annotated classes and their companion $$serializer
-keep,includedescriptorclasses class **$$serializer { *; }

# Keep the serializer companion object accessor
-keepclassmembers class **$Companion {
    kotlinx.serialization.KSerializer serializer(**);
}

# Keep our @Serializable classes — needed for reflective serializer lookup.
# Narrowed to our package only — SDKs ship their own consumer rules that
# keep their internal @Serializable classes. A blanket keep on ALL
# @Serializable classes prevents R8 from shrinking SDK code and causes OOM.
-keep @kotlinx.serialization.Serializable class cookscopeai.com.** {
    *;
}

# Keep SerialName annotations on our serializable fields
-keepclassmembers @kotlinx.serialization.Serializable class cookscopeai.com.** {
    @kotlinx.serialization.SerialName <fields>;
}

# ---------------------------------------------------------------------------
# CookScope data models — @Serializable classes in the data package.
# Field names are used as JSON keys — must not be obfuscated.
# ---------------------------------------------------------------------------
-keep class cookscopeai.com.data.** { *; }
-keep class cookscopeai.com.Config { *; }
-keep class cookscopeai.com.ConfigExtensionsKt { *; }
-keep class cookscopeai.com.IntegrityChecker { *; }

# ---------------------------------------------------------------------------
# Native methods — keep classes with native members
# ---------------------------------------------------------------------------
-keepclasseswithmembers class * {
    native <methods>;
}

# ---------------------------------------------------------------------------
# Kotlin metadata — keep for reflection-based libraries
# ---------------------------------------------------------------------------
-keep class kotlin.Metadata { *; }

# ---------------------------------------------------------------------------
# Suppress warnings for SDK-internal classes that reference platform APIs
# not available in the compile SDK (harmless — consumer rules handle keeps)
# ---------------------------------------------------------------------------
-dontwarn javax.annotation.**
-dontwarn org.jetbrains.annotations.**

# ---------------------------------------------------------------------------
# Missing classes referenced by SDK internals but not available on Android
# (generated by R8 — these are JVM desktop classes that Ktor references
# in debug-only code paths, never called at runtime on Android)
# ---------------------------------------------------------------------------
-dontwarn java.lang.management.ManagementFactory
-dontwarn java.lang.management.RuntimeMXBean
-dontwarn java.lang.reflect.AnnotatedType
